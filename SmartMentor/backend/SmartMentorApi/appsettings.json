{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=SmartMentorDb;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;"
  },

  "JwtSettings": {
    "Secret": "ThisIsASuperSecretKey123456789",
    "Issuer": "SmartMentor.API",
    "Audience": "SmartMentor.Client",
    "DurationInDays": 1
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=.\\SQLEXPRESS;Database=SmartMentorDb;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "ApplicationName": "SmartMentor API"
    }
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "SmartMentor",
    "SenderEmail": "ahmeducfjf@gmail.com",
    "Username": "ahmeducfjf@gmail.com",
    "Password": "jzfoadmffrofrvyd"
  }
}